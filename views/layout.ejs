<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Scraplet Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    a:hover { transition: color 0.2s ease-in-out; }
  </style>
</head>

<body class="bg-gray-950 text-white min-h-screen font-sans">

  <!-- Unified Dashboard Header -->
  <header class="bg-gray-900 border-b border-gray-800 text-gray-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <!-- Brand -->
      <div class="text-2xl font-bold text-indigo-400 tracking-wide">
        Scraplet<span class="text-indigo-200">Dashboard</span>
      </div>

      <!-- Nav links -->
      <nav class="flex items-center gap-6 text-sm">
        <a href="/dashboard"
           class="<%= activeTab === 'overview' ? 'text-indigo-400' : 'text-gray-300 hover:text-indigo-300' %>">Overview</a>
        <a href="/dashboard/stats"
           class="<%= activeTab === 'stats' ? 'text-indigo-400' : 'text-gray-300 hover:text-indigo-300' %>">Stats</a>
        <a href="/dashboard/widgets"
           class="<%= activeTab === 'widgets' ? 'text-indigo-400' : 'text-gray-300 hover:text-indigo-300' %>">Widgets</a>
        <a href="/dashboard/account"
           class="<%= activeTab === 'account' ? 'text-indigo-400' : 'text-gray-300 hover:text-indigo-300' %>">Account</a>
        <% if (user?.isAdmin) { %>
          <a href="/dashboard/admin"
             class="<%= activeTab === 'admin' ? 'text-indigo-400' : 'text-gray-300 hover:text-indigo-300' %>">Admin</a>
        <% } %>
      </nav>

      <!-- User / logout -->
      <div class="flex items-center gap-3">
        <span class="text-sm text-gray-400">Hi, <%= user.username %></span>
        <a href="/logout" class="text-sm text-gray-400 hover:text-red-400">Logout</a>
      </div>
    </div>
  </header>

  <!-- Main content -->
  <main class="px-6 py-10">
    <div class="max-w-6xl mx-auto space-y-10">
      <%- include(tabView, locals) %>
    </div>
  </main>

  <!-- Optional footer -->
  <footer class="mt-12 py-6 border-t border-gray-800 text-center text-sm text-gray-600">
    © <%= new Date().getFullYear() %> Scraplet · All rights reserved
  </footer>

</body>
</html>
