<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Scraplet Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-white min-h-screen flex flex-col">

  <!-- Global header / nav -->
  <%- include('partials/dashboard-header', { user }) %>

  <!-- Page content -->
  <main class="flex-1 px-4 sm:px-6 md:px-8 py-8">
    <!-- tabView is the name of the inner view: 'dashboard', 'dashboard-metrics', 'dashboard-stats', etc -->
    <%- include(tabView) %>
  </main>

  <!-- Global footer -->
  <%- include('partials/dashboard-footer') %>
</body>
</html>
