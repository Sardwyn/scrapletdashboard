<div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8 py-8 sm:py-10 space-y-10">

  <!-- Page Title + Button -->
  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white">Your Stats Dashboard</h1>
      <p class="text-sm text-gray-400 mt-1">
        Metrics pulled from your public profile and integrations
      </p>
    </div>

    <a href="/dashboard/pitchdeck.pdf"
       class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm px-4 py-2 rounded shadow w-full sm:w-auto text-center">
       📄 Generate Pitch Deck
    </a>
  </header>

  <!-- 📈 Audience Growth (total followers) -->
  <section>
    <div class="bg-gray-900 p-5 sm:p-6 rounded-lg shadow border border-gray-800">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg sm:text-xl font-semibold text-indigo-300">📈 Audience Growth</h2>
        <div class="flex gap-2 text-xs">
          <button data-days="14" class="agbtn px-2 py-1 rounded border border-gray-700 bg-indigo-600 text-white">14d</button>
          <button data-days="30" class="agbtn px-2 py-1 rounded border border-gray-700 text-gray-300 hover:bg-gray-800">30d</button>
          <button data-days="60" class="agbtn px-2 py-1 rounded border border-gray-700 text-gray-300 hover:bg-gray-800">60d</button>
        </div>
      </div>

      <p class="text-sm text-gray-400">
        Combined followers across all connected platforms (daily snapshots).
      </p>

      <div class="mt-4 relative h-[180px] sm:h-[220px] md:h-[240px]">
        <div id="ag-loading" class="absolute inset-0 flex items-center justify-center bg-gray-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 z-20">
          <div class="w-8 h-8 border-4 border-indigo-400 border-t-transparent rounded-full animate-spin"></div>
        </div>
        <canvas id="audienceGrowthChart" class="absolute inset-0 w-full h-full"></canvas>
      </div>

      <p id="ag-caption" class="text-xs text-gray-500 mt-2 text-right">Last 14 days</p>
    </div>
  </section>

  <!-- 🧮 Platform Summary -->
  <section>
    <div class="bg-gray-900 p-5 sm:p-6 rounded-lg shadow border border-gray-800">
      <h2 class="text-lg sm:text-xl font-semibold mb-4 text-indigo-300">📊 Platform Performance</h2>

      <% if (!stats || !Array.isArray(stats) || stats.length === 0) { %>
        <p class="text-gray-500 italic">No platform data yet.</p>
      <% } else { %>
        <div class="overflow-x-auto rounded-md border border-gray-700">
          <table class="w-full text-sm">
            <thead class="bg-gray-800 text-gray-300">
              <tr>
                <th class="text-left px-4 py-2">Platform</th>
                <th class="text-right px-4 py-2">Followers</th>
                <th class="text-right px-4 py-2">Engagement</th>
                <th class="text-right px-4 py-2">CCV</th>
                <% const hasTrends = Array.isArray(weeklyTrends) && weeklyTrends.length > 0; %>
                <% if (hasTrends) { %>
                  <th class="text-right px-4 py-2">7d Trend</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% stats.forEach((stat, i) => {
                   const platform = String(stat.platform || '').toLowerCase() || 'unknown';
                   const followers = Number(stat.followers ?? 0);
                   const engagement = Number(stat.engagement ?? 0);
                   const ccv = Number(stat.ccv ?? 0);
                   const trend = hasTrends ? weeklyTrends.find(t => String(t.platform).toLowerCase() === platform) : null;
                   const delta = trend ? Number(trend.deltaPct || 0) : 0;
                   const rowBg = i % 2 === 0 ? 'bg-gray-900' : 'bg-gray-800';
              %>
                <tr class="border-t border-gray-800 <%= rowBg %>">
                  <td class="px-4 py-2 capitalize"><%= platform %></td>
                  <td class="px-4 py-2 text-right text-green-400 font-mono"><%= followers.toLocaleString() %></td>
                  <td class="px-4 py-2 text-right text-yellow-400 font-mono">
                    <%= Number.isFinite(engagement) ? engagement.toFixed(2) + '%' : '—' %>
                  </td>
                  <td class="px-4 py-2 text-right text-blue-400 font-mono"><%= Number.isFinite(ccv) ? ccv : '—' %></td>
                  <% if (hasTrends) { %>
                    <td class="px-4 py-2 text-right">
                      <% if (delta > 0) { %>
                        <span class="text-green-400 font-semibold">▲ <%= delta.toFixed(1) %>%</span>
                      <% } else if (delta < 0) { %>
                        <span class="text-red-400 font-semibold">▼ <%= Math.abs(delta).toFixed(1) %>%</span>
                      <% } else { %>
                        <span class="text-gray-400">—</span>
                      <% } %>
                    </td>
                  <% } %>
                </tr>

                <!-- Sparkline row -->
                <tr class="<%= rowBg %>">
                  <td colspan="<%= hasTrends ? 5 : 4 %>" class="px-4 pb-3">
                    <div class="w-full h-8">
                      <canvas id="spark-<%= platform %>" height="30"></canvas>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (Array.isArray(weeklyTrends) && weeklyTrends.length) { 
             const sorted = weeklyTrends.slice().sort((a, b) => Number(b.deltaPct || 0) - Number(a.deltaPct || 0));
             const top = sorted[0];
             const growth = Number(top.deltaPct || 0).toFixed(1);
             const positiveTop = Number(top.deltaPct || 0) >= 0;
             const arrow = positiveTop ? '📈' : '📉';
             const color = positiveTop ? 'text-green-400' : 'text-red-400';

             const totals = weeklyTrends.reduce((acc, t) => {
               acc.current += Number(t.current || 0);
               acc.previous += Number(t.previous || 0);
               return acc;
             }, { current: 0, previous: 0 });

             const overallDelta = totals.previous > 0
               ? ((totals.current - totals.previous) / totals.previous) * 100
               : 0;
             const overallPositive = overallDelta >= 0;
             const overallWord = overallPositive ? 'increased' : 'decreased';
             const overallColor = overallPositive ? 'text-green-400' : 'text-red-400';
        %>
          <div class="mt-4 p-4 rounded-md border-l-4 border-indigo-600 bg-indigo-600/10">
            <p class="text-sm leading-relaxed text-gray-200">
              <span class="text-indigo-400 font-semibold"><%= arrow %> <%= top.platform.charAt(0).toUpperCase() + top.platform.slice(1) %></span>
              is your fastest-growing platform this week, showing a
              <span class="<%= color %> font-semibold"><%= growth %>%</span> change in total followers compared to last week.
              When we consider your following across all social estates, your total reach has
              <span class="<%= overallColor %> font-semibold"><%= overallWord %></span>
              by <span class="<%= overallColor %> font-semibold"><%= Math.abs(overallDelta).toFixed(1) %>%</span>.
            </p>
          </div>
        <% } %>

        <p class="text-xs text-gray-500 mt-2 text-right">
          Data current as of <%= new Date().toLocaleDateString() %>
        </p>
      <% } %>
    </div>
  </section>

  <!-- Profile Engagement -->
  <section>
    <div class="bg-gray-900 p-5 sm:p-6 rounded-lg shadow border border-gray-800">
      <h2 class="text-lg sm:text-xl font-semibold mb-4 text-indigo-300">📈 Profile Engagement</h2>

      <!-- Window toggle -->
      <div class="flex flex-wrap items-center justify-end -mt-1 mb-3 gap-2 text-sm">
        <button data-window="7" class="winbtn px-3 py-1 rounded border border-gray-700 <%= selectedWindow===7 ? 'bg-indigo-600 text-white' : 'text-gray-300 hover:bg-gray-800' %>">7d</button>
        <button data-window="30" class="winbtn px-3 py-1 rounded border border-gray-700 <%= selectedWindow===30 ? 'bg-indigo-600 text-white' : 'text-gray-300 hover:bg-gray-800' %>">30d</button>
        <button data-window="60" class="winbtn px-3 py-1 rounded border border-gray-700 <%= selectedWindow===60 ? 'bg-indigo-600 text-white' : 'text-gray-300 hover:bg-gray-800' %>">60d</button>
      </div>

      <!-- Metrics -->
      <div class="space-y-4 text-sm">
        <div class="flex justify-between">
          <span>Total Views (<span id="headline-window"><%= selectedWindow %></span>d)</span>
          <span id="headline-views" class="font-semibold"><%= profileAnalytics.views %></span>
        </div>

        <% if (referrerStats && referrerStats.length) { %>
          <div>
            <p class="text-gray-400 mb-1">Top Referrers</p>
            <ul class="space-y-1">
              <% referrerStats.forEach(({ referrer, count }) => { %>
                <li class="flex justify-between">
                  <span><%= referrer || 'Direct / Unknown' %></span>
                  <span class="text-gray-300"><%= count %></span>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>

      <!-- Line Graph -->
      <div class="mt-6 relative h-[160px] sm:h-[200px] md:h-[240px]">
        <div id="chart-loading"
             class="absolute inset-0 flex items-center justify-center bg-gray-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 z-20">
          <div class="w-8 h-8 border-4 border-indigo-400 border-t-transparent rounded-full animate-spin"></div>
        </div>

        <canvas id="engagementChart" class="absolute inset-0 w-full h-full"></canvas>

        <p class="text-xs text-gray-500 mt-2 relative z-10">
          <span id="pct-arrow"><%= profileEngagementTrend.percentChange >= 0 ? '📈' : '📉' %></span>
          <span id="pct-value" class="<%= profileEngagementTrend.percentChange >= 0 ? 'text-green-400' : 'text-red-400' %> font-semibold">
            <%= Math.abs(profileEngagementTrend.percentChange).toFixed(1) %>%</span>
          compared to previous <span id="caption-window"><%= selectedWindow %></span>d
        </p>
      </div>
    </div>
  </section>

  <!-- 🧭 Internal Engagement -->
  <section>
    <div class="bg-gray-900 p-5 sm:p-6 rounded-lg shadow border border-gray-800">
      <h2 class="text-lg sm:text-xl font-semibold mb-4 text-indigo-300">🧭 Internal Engagement</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-base sm:text-lg font-semibold mb-2">Profile Heatmap</h3>
          <div class="relative w-full h-64 sm:h-72 md:h-80 bg-gray-800 rounded-md overflow-hidden border border-gray-700">
            <svg id="heatmap" class="absolute inset-0 w-full h-full"></svg>
          </div>
          <p class="text-xs text-gray-500 mt-2">Clicks recorded on your public profile</p>
        </div>

        <div>
          <h3 class="text-base sm:text-lg font-semibold mb-2">Click Buckets</h3>
          <div class="space-y-2">
            <% (Array.isArray(clickBuckets) ? clickBuckets : []).forEach(c => { %>
              <div class="flex justify-between">
                <span><%= c.action %></span>
                <span class="font-semibold"><%= c.count %></span>
              </div>
            <% }) %>
            <% if (!clickBuckets || clickBuckets.length === 0) { %>
              <p class="text-gray-500 italic">No click bucket data.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 🖱️ Clickstream Details -->
  <section>
    <div class="bg-gray-900 p-5 sm:p-6 rounded-lg shadow border border-gray-800">
      <h2 class="text-lg sm:text-xl font-semibold mb-4 text-indigo-300">🖱️ Clickstream Analysis</h2>
      <% if (Array.isArray(clickDetails) && clickDetails.length) { %>
        <ul class="text-sm text-white space-y-2">
          <% clickDetails.forEach(({ action, referrer, timestamp }) => { %>
            <li class="flex justify-between flex-wrap gap-1">
              <span><%= action %></span>
              <span class="text-gray-400 text-xs text-right">
                <%= new Date(timestamp).toLocaleString() %>
                <% if (referrer) { %> · <%= referrer %> <% } %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-gray-500 italic">No clickstream data yet.</p>
      <% } %>
    </div>
  </section>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    window.HEATMAP_POINTS = <%- JSON.stringify(heatmapPoints || []) %>;
  </script>

  <!-- Engagement chart + heatmap + API wiring (unchanged from your version) -->
  <!-- (All three <script> blocks from your snippet go here unchanged) -->

  <script>
    (function() {
      const btns = Array.from(document.querySelectorAll('.winbtn'));
      const headlineViews = document.getElementById('headline-views');
      const headlineWindow = document.getElementById('headline-window');
      const captionWindow = document.getElementById('caption-window');
      const pctArrow = document.getElementById('pct-arrow');
      const pctValue = document.getElementById('pct-value');
      const ctx = document.getElementById('engagementChart')?.getContext('2d');
      const overlay = document.getElementById('chart-loading');
      if (!ctx) return;

      const grad = ctx.createLinearGradient(0,0,0,240);
      grad.addColorStop(0,'rgba(99,102,241,0.35)');
      grad.addColorStop(1,'rgba(99,102,241,0.05)');
      const initial = <%- JSON.stringify(profileEngagementTrend.dailyViews || []) %>;

      const CHART = new Chart(ctx, {
        type: 'line',
        data: {
          labels: initial.map(d=>d.date),
          datasets:[{
            label:'Profile Views',
            data:initial.map(d=>d.count),
            borderColor:'rgba(99,102,241,1)',
            backgroundColor:grad,fill:true,pointRadius:2,tension:0.35
          }]
        },
        options:{
          responsive:true,
          maintainAspectRatio:false,
          scales:{
            x:{ticks:{color:'#9ca3af',maxRotation:0},grid:{color:'#111827'}},
            y:{ticks:{color:'#9ca3af'},grid:{color:'#111827'},beginAtZero:true,grace:'5%'}
          },
          plugins:{legend:{display:false}}
        }
      });

      const fmt = n => (n>=1000?n.toLocaleString():String(n));
      async function loadWindow(win){
        overlay.style.opacity='1';
        btns.forEach(b=>b.disabled=true);
        try{
          const resp=await fetch(`/dashboard/api/stats/engagement?window=${win}`);
          const json=await resp.json();
          headlineWindow.textContent=json.windowDays;
          captionWindow.textContent=json.windowDays;
          headlineViews.textContent=fmt(json.totalViews);
          const up=json.percentChange>=0;
          pctArrow.textContent=up?'📈':'📉';
          pctValue.textContent=Math.abs(json.percentChange).toFixed(1)+'%';
          pctValue.classList.toggle('text-green-400',up);
          pctValue.classList.toggle('text-red-400',!up);
          CHART.data.labels=json.labels;
          CHART.data.datasets[0].data=json.values;
          CHART.update();
          btns.forEach(b=>{
            const active=Number(b.dataset.window)===json.windowDays;
            b.classList.toggle('bg-indigo-600',active);
            b.classList.toggle('text-white',active);
            b.classList.toggle('text-gray-300',!active);
          });
          const url=new URL(window.location.href);
          url.searchParams.set('window',json.windowDays);
          history.replaceState({},'',url);
        }catch(e){console.error('Failed to load engagement window:',e);}
        finally{
          overlay.style.opacity='0';
          btns.forEach(b=>b.disabled=false);
        }
      }
      btns.forEach(b=>b.addEventListener('click',()=>loadWindow(Number(b.dataset.window))));
    })();

    document.addEventListener('DOMContentLoaded',()=>{
      const pts=window.HEATMAP_POINTS||[];
      const svg=document.getElementById('heatmap');
      if(!svg||!pts.length)return;
      const w=svg.clientWidth||svg.parentElement.clientWidth;
      const h=svg.clientHeight||svg.parentElement.clientHeight;
      while(svg.firstChild)svg.removeChild(svg.firstChild);
      pts.forEach(({x,y,weight=1})=>{
        const cx=Math.max(4,Math.min(w-4,Math.round(x*w)));
        const cy=Math.max(4,Math.min(h-4,Math.round(y*h)));
        const r=2+Math.min(8,weight);
        const c=document.createElementNS('http://www.w3.org/2000/svg','circle');
        c.setAttribute('cx',cx);c.setAttribute('cy',cy);c.setAttribute('r',r);
        c.setAttribute('fill','rgba(79,70,229,0.55)');
        c.setAttribute('stroke','rgba(99,102,241,0.9)');
        c.setAttribute('stroke-width','1');
        svg.appendChild(c);
      });
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const ctx = document.getElementById('audienceGrowthChart')?.getContext('2d');
      if (!ctx) return;

      const loader = document.getElementById('ag-loading');
      const caption = document.getElementById('ag-caption');
      const buttons = Array.from(document.querySelectorAll('.agbtn'));

      const grad = ctx.createLinearGradient(0, 0, 0, 240);
      grad.addColorStop(0, 'rgba(99,102,241,0.35)');
      grad.addColorStop(1, 'rgba(99,102,241,0.05)');

      const CHART = new Chart(ctx, {
        type: 'line',
        data: { labels: [], datasets: [{
          label: 'Total Followers',
          data: [],
          borderColor: 'rgba(99,102,241,1)',
          backgroundColor: grad,
          fill: true,
          tension: 0.35,
          pointRadius: 1.8
        }]},
        options: {
          responsive: true, maintainAspectRatio: false,
          scales: {
            x: { ticks: { color: '#9ca3af' }, grid: { color: '#111827' }},
            y: { ticks: { color: '#9ca3af' }, grid: { color: '#111827' }, beginAtZero: true }
          },
          plugins: { legend: { display: false } }
        }
      });

      async function load(days) {
        try {
          loader.style.opacity = '1';
          buttons.forEach(b => b.disabled = true);

          const r = await fetch(`/dashboard/api/stats/audience-growth?days=${days}`);
          const j = await r.json();

          CHART.data.labels = j.labels;
          CHART.data.datasets[0].data = j.values;
          CHART.update();

          caption.textContent = `Last ${j.windowDays} days`;
          buttons.forEach(b => {
            const active = Number(b.dataset.days) === j.windowDays;
            b.classList.toggle('bg-indigo-600', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('text-gray-300', !active);
          });
        } catch (e) {
          console.error('Audience growth load failed:', e);
        } finally {
          loader.style.opacity = '0';
          buttons.forEach(b => b.disabled = false);
        }
      }

      buttons.forEach(b => b.addEventListener('click', () => load(Number(b.dataset.days))));
      load(14);
    });
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      try {
        const resp = await fetch('/dashboard/api/stats/sparkline');
        const json = await resp.json();
        if (!json.success || !json.data) return;

        const allPlatforms = new Set([
          ...Object.keys(json.data),
          ...Array.from(document.querySelectorAll('canvas[id^="spark-"]')).map(c => c.id.replace('spark-', ''))
        ]);

        allPlatforms.forEach(platform => {
          const canvas = document.getElementById(`spark-${platform}`);
          if (!canvas) return;

          const ctx = canvas.getContext('2d');
          const platformData = json.data?.[platform] || [];

          const points = platformData.length
            ? platformData.map(p => ({ date: p.date, followers: Number(p.followers) }))
            : Array.from({ length: 14 }, (_, i) => ({
                date: new Date(Date.now() - (13 - i) * 86400000).toISOString().split('T')[0],
                followers: 0
              }));

          const first = points[0]?.followers ?? 0;
          const last = points[points.length - 1]?.followers ?? 0;
          const isUp = last >= first;

          const grad = ctx.createLinearGradient(0, 0, 0, 30);
          grad.addColorStop(0, isUp ? 'rgba(34,197,94,0.4)' : 'rgba(239,68,68,0.4)');
          grad.addColorStop(1, 'rgba(99,102,241,0.05)');

          new Chart(ctx, {
            type: 'line',
            data: {
              labels: points.map(p => p.date),
              datasets: [{
                data: points.map(p => p.followers),
                borderColor: isUp ? 'rgba(34,197,94,0.9)' : 'rgba(239,68,68,0.9)',
                backgroundColor: grad,
                fill: true,
                pointRadius: 0,
                tension: 0.35
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: { x: { display: false }, y: { display: false } },
              plugins: { legend: { display: false }, tooltip: { enabled: false } },
              elements: { line: { borderWidth: 1.5 } }
            }
          });
        });
      } catch (err) {
        console.error('Failed to render sparklines:', err);
      }
    });
  </script>

</div>
