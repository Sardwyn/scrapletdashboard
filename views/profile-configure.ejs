<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Configure Profile Layout</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
</head>
<body class="bg-gray-950 text-white font-sans px-6 py-10">

<%
  const labelMap = {
    avatar: 'Avatar',
    bio: 'Bio',
    socialLinks: 'Social Links',
    stats: 'Stats',
    sponsorBanner: 'Sponsor Banner',
    customHtml: 'Custom HTML',
    featuredWidget: 'Featured Widget'
  };
%>

<div class="max-w-2xl mx-auto bg-gray-900 p-8 rounded-xl shadow-lg border border-gray-800">
  <h1 class="text-2xl font-bold mb-6">Configure Profile Layout</h1>

  <form method="POST" action="/profile/configure">
    <h2 class="text-xl font-semibold mb-4">Profile Sections</h2>
    <ul id="section-list" class="space-y-3">
      <% layout.sections.forEach(section => {
        const type = section.type;
        const label = labelMap[type] || type;
        const isPremium = section.premium === true;
        const isVisible = section.visible === true;
        const isAllowed = !isPremium || user.plan === 'pro';

        if (isAllowed) {
      %>
        <li class="bg-gray-800 p-4 rounded flex items-center justify-between" data-id="<%= type %>">
          <div class="flex items-center gap-3">
            <div class="cursor-move text-xl">☰</div>
            <div class="font-semibold text-base"><%= label %></div>
          </div>
          <label class="flex items-center text-sm">
            <input type="checkbox" name="<%= type %>" <%= isVisible ? 'checked' : '' %> class="mr-2" />
            Show
          </label>
        </li>
      <% } %>
      <% }) %>
    </ul>

    <div id="section-order-container"></div>


    <div class="mt-6">
      <label class="inline-flex items-center">
        <input type="checkbox" name="showButtonIcons" <%= layout.showButtonIcons ? 'checked' : '' %> class="mr-2" />
        Show icons on custom buttons
      </label>
    </div>

    <% if (customButtons.length > 0) { %>
  <h2 class="text-xl font-semibold mt-10 mb-4">Custom Buttons</h2>
  <ul id="button-list" class="space-y-3">
    <% customButtons.forEach(btn => { %>
      <li class="bg-gray-800 p-4 rounded flex items-center justify-between" data-id="<%= btn.id %>">
        <div class="flex items-center gap-3">
          <div class="cursor-move text-xl">☰</div>
          <div class="font-semibold text-base"><%= btn.label %></div>
        </div>
        <label class="flex items-center text-sm">
          <input type="checkbox" name="buttonVisible[<%= btn.id %>]" <%= btn.visible ? 'checked' : '' %> class="mr-2" />
          Show
        </label>
      </li>
    <% }) %>
  </ul>
  <div id="button-order-container"></div>

<% } %>


    <button type="submit" class="mt-6 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded">
      Save Layout
    </button>
  </form>
</div>

<script>
  const sectionList = document.getElementById('section-list');
  const sectionOrderContainer = document.getElementById('section-order-container');

  Sortable.create(sectionList, {
    animation: 150,
    onEnd: () => {
      updateSectionOrderInputs();
    }
  });

  function updateSectionOrderInputs() {
    sectionOrderContainer.innerHTML = '';
    Array.from(sectionList.children).forEach(li => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'sectionOrder[]';
      input.value = li.dataset.id;
      sectionOrderContainer.appendChild(input);
    });
  }

  updateSectionOrderInputs();

  const buttonList = document.getElementById('button-list');
  const buttonOrderContainer = document.getElementById('button-order-container');

  if (buttonList && buttonOrderContainer) {
    Sortable.create(buttonList, {
      animation: 150,
      onEnd: () => {
        updateButtonOrderInputs();
      }
    });

    function updateButtonOrderInputs() {
      buttonOrderContainer.innerHTML = '';
      Array.from(buttonList.children).forEach(li => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'buttonOrder[]';
        input.value = li.dataset.id;
        buttonOrderContainer.appendChild(input);
      });
    }

    updateButtonOrderInputs();
  }
</script>



</body>
</html>
