<header class="bg-gray-900 border-b border-gray-800 text-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-4">
    <div class="text-2xl font-bold text-indigo-400 tracking-wide">
      Scraplet<span class="text-indigo-200">Dashboard</span>
    </div>

    <nav class="flex flex-wrap items-center gap-4 text-sm">
      <a href="/dashboard" class="text-gray-300 hover:text-indigo-300">Overview</a>
      <a href="/dashboard/stats" class="text-gray-300 hover:text-indigo-300">Stats</a>
      <a href="/dashboard/metrics" class="text-gray-300 hover:text-indigo-300">Metrics</a>
      <a href="/dashboard/widgets" class="text-gray-300 hover:text-indigo-300">Widgets</a>
      <a href="/dashboard/overlays" class="text-gray-300 hover:text-indigo-300">Overlays</a>
      <a href="/account" class="text-gray-300 hover:text-indigo-300">Account</a>
      <% if (user?.isAdmin) { %>
        <a href="/admin" class="text-gray-300 hover:text-indigo-300">Admin</a>
      <% } %>
    </nav>

    <div class="flex items-center gap-3 text-sm">
      <span class="text-gray-400">Hi, <%= user?.username || 'Creator' %></span>
      <form action="/auth/logout" method="POST">
        <button
          type="submit"
          class="px-3 py-1 rounded bg-red-600 hover:bg-red-700 text-white text-xs">
          Logout
        </button>
      </form>
    </div>
  </div>
</header>
