<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Log In</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-white font-sans flex items-center justify-center min-h-screen px-6">

  <div class="max-w-md w-full bg-gray-900 p-8 rounded-xl shadow-lg border border-gray-800">
    <h1 class="text-3xl font-bold mb-6 text-center">Log In</h1>

    <form action="/auth/login" method="POST" class="space-y-6">
      <div>
        <label class="block text-sm font-semibold mb-1 text-gray-300">Email</label>
        <input type="email" name="email" placeholder="you@example.com" required
               class="bg-gray-800 text-white p-2 rounded w-full border border-gray-700" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1 text-gray-300">Password</label>
        <input type="password" name="password" placeholder="••••••••" required
               class="bg-gray-800 text-white p-2 rounded w-full border border-gray-700" />
      </div>

      <button type="submit"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded shadow transition">
        Log In
      </button>
    </form>
  </div>

</body>
</html>
