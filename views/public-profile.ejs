<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= username %>'s Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-white font-sans px-6 py-10">

<%
  const visibilityMap = sectionVisibility && typeof sectionVisibility === 'object'
    ? sectionVisibility
    : Array.isArray(layout?.sections)
      ? layout.sections.reduce((acc, section) => {
          if (section?.type) acc[section.type] = section.visible === true;
          return acc;
        }, {})
      : {};

  const isSectionVisible = type => visibilityMap[type] === true;
  const formatCount = value => {
    const numeric = Number(value);
    return Number.isFinite(numeric) ? numeric.toLocaleString() : (value ?? '0');
  };

  const followerEntries = Object.entries(stats?.followers || {});
  const ccvEntries = Object.entries(stats?.ccv || {});
  const hasStatsData = followerEntries.length > 0 || ccvEntries.length > 0;

  const sectionMap = new Map();
  layout.sections.forEach(s => {
    if (s?.type) sectionMap.set(s.type, s);
  });
%>

<div class="max-w-2xl mx-auto bg-gray-900 p-8 rounded-xl shadow-lg border border-gray-800">

  <!-- Identity Block -->
  <div class="flex items-center space-x-4 mb-6">
    <% if (profile.avatar_url) { %>
      <img src="<%= profile.avatar_url %>" alt="Avatar" class="w-16 h-16 rounded-full border border-gray-700" />
    <% } %>
    <div>
      <h1 class="text-2xl font-bold"><%= profile.display_name || username %></h1>
      <% if (profile.business_email) { %>
        <p class="text-blue-400 hover:underline">
          <a href="mailto:<%= profile.business_email %>"><%= profile.business_email %></a>
        </p>
      <% } %>
    </div>
  </div>

  <!-- Dynamic Section Rendering -->
  <% layout.sections.forEach(section => {
  const { type } = section;

    if (section?.visible && (!section.premium || profile.plan === 'pro')) {

  %>
    <div class="mb-6">
      <% if (type === 'stats') { %>
        <% if (hasStatsData) { %>
          <div class="bg-gray-900 p-6 rounded-lg shadow-md border border-gray-800">
            <h3 class="text-xl font-bold mb-4 text-indigo-300">📊 Reach & Engagement</h3>
            <div class="space-y-4 text-sm text-white">
              <% followerEntries.forEach(([platform, count]) => { %>
                <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                  <div class="flex items-center gap-2">
                    <img src="/icons/<%= platform %>.svg" alt="<%= platform %>" class="w-4 h-4" />
                    <span class="capitalize"><%= platform %> followers</span>
                  </div>
                  <span class="font-semibold"><%= formatCount(count) %></span>
                </div>
              <% }) %>

              <% ccvEntries.forEach(([platform, count]) => { %>
                <div class="flex items-center justify-between border-b border-gray-800 pb-2">
                  <div class="flex items-center gap-2">
                    <img src="/icons/<%= platform %>.svg" alt="<%= platform %>" class="w-4 h-4" />
                    <span class="capitalize"><%= platform %> CCV</span>
                  </div>
                  <span class="font-semibold"><%= formatCount(count) %></span>
                </div>
              <% }) %>

              <% if (marketability) { %>
                <div class="flex justify-between pt-2 text-indigo-400 font-bold">
                  <span>Marketability Grade</span>
                  <span><%= marketability %></span>
                </div>
              <% } %>

              <% if (stats?.last_updated) { %>
                <p class="text-xs text-gray-500 mt-2">Last updated: <%= new Date(stats.last_updated).toLocaleString() %></p>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <p class="text-sm text-red-400">⚠️ Stats unavailable — API may be down or not linked.</p>
        <% } %>

      <% } else if (type === 'socialLinks') { %>
        <div class="flex justify-center space-x-6">
          <% if (profile.x) { %>
            <a href="https://x.com/<%= profile.x %>" target="_blank" class="text-blue-400 hover:underline">X</a>
          <% } %>
          <% if (profile.youtube) { %>
            <a href="<%= profile.youtube %>" class="text-red-400 hover:underline">YouTube</a>
          <% } %>
          <% if (profile.twitch) { %>
            <a href="<%= profile.twitch %>" class="text-purple-400 hover:underline">Twitch</a>
          <% } %>
        </div>

      <% } else if (type === 'sponsorBanner') { %>
        <% if (profile.sponsors?.length > 0) { %>
          <div class="space-y-6">
            <% profile.sponsors.forEach(s => { %>
              <div class="bg-gray-800 rounded-xl shadow border border-gray-700 overflow-hidden">
                <% if (s.banner_url) { %>
                  <a href="<%= s.url %>" target="_blank">
                    <img src="<%= s.banner_url %>" alt="<%= s.name %> banner" class="w-full h-40 object-cover" />
                  </a>
                <% } else { %>
                  <a href="<%= s.url %>" target="_blank" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-700 transition">
                    <% if (s.logo_url) { %>
                      <img src="<%= s.logo_url %>" alt="<%= s.name %>" class="h-6 w-auto max-w-[120px] object-contain" />
                    <% } %>
                    <span class="text-sm text-white font-medium"><%= s.name %></span>
                  </a>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-sm text-gray-500 italic">No sponsors configured.</p>
        <% } %>

      <% } else if (type === 'avatar') { %>
        <!-- Avatar already rendered -->

      <% } else if (type === 'bio') { %>
        <% if (profile.bio) { %>
          <div class="bg-gray-800 p-4 rounded text-sm text-gray-300">
            <p><%= profile.bio %></p>
          </div>
        <% } %>

      <% } else if (type === 'featuredWidget') { %>
        <div class="bg-gray-800 p-4 rounded">
          <p class="text-gray-400 italic">Featured Widget (Premium)</p>
        </div>

      <% } else if (type === 'customHtml') { %>
        <div class="bg-gray-800 p-4 rounded mt-6">
          <p class="text-gray-400 italic">Custom HTML Block (Premium)</p>
        </div>

      <% } else { %>
        <div class="bg-gray-800 p-4 rounded">
          <p class="text-gray-400 italic">Unknown section: <%= type %></p>
        </div>
      <% } %>
    </div>
  <% } %>
<% }) %>

  <!-- Custom Buttons -->
  <% if (customButtons.length > 0) { %>
    <div class="mt-6 space-y-4">
      <% customButtons.forEach(btn => { %>
        <a href="<%= btn.url %>" target="_blank" class="flex items-center justify-center gap-3 bg-blue-600 text-white p-4 rounded-lg text-lg font-semibold shadow hover:bg-blue-700">
          <% if (layout.showButtonIcons && btn.icon) { %>
            <img src="/icons/<%= btn.icon || 'default' %>.svg" alt="<%= btn.label %> icon" class="w-5 h-5" />
          <% } %>
          <span><%= btn.label %></span>
        </a>
      <% }) %>
    </div>
  <% } %>

</div>
</body>
</html>
